DATA_DIR = Path(__file__).resolve().parents[1] / "data"


def load_examples(dataset_name: str, n: int, seed: int) -> pd.DataFrame:
    cfg = DATASETS[dataset_name]

    # Prefer the local copy written by src/setup/download_dataset.py; it is already
    # filtered, so filter_fn only applies to the Hub path.
    local_dir = DATA_DIR / dataset_name
    if local_dir.exists():
        ds = load_from_disk(str(local_dir))[cfg["split"]]
    else:
        load_kw: dict = {"split": cfg["split"]}
        if cfg["hf_config"]:
            ds = load_dataset(cfg["hf_name"], cfg["hf_config"], **load_kw)
        else:
            ds = load_dataset(cfg["hf_name"], **load_kw)
        if cfg["filter_fn"]:
            ds = ds.filter(cfg["filter_fn"])

    n = min(n, len(ds))
    rng = np.random.default_rng(seed)
    indices = sorted(rng.choice(len(ds), size=n, replace=False).tolist())
    selected = ds.select(indices)

    rows = []
    for i, (idx, ex) in enumerate(zip(indices, selected)):
        ch = cfg["choices"](ex) if cfg["choices"] else None
        rows.append(dict(
            example_id=i,
            dataset_index=int(idx),
            question=cfg["question"](ex),
            gold_answer=str(cfg["gold"](ex)),
            choices=json.dumps(ch) if ch is not None else None,
        ))
    return pd.DataFrame(rows)


# ── I/O helpers ───────────────────────────────────────────────────────────────

def _append_jsonl(path: Path, records: list[dict]) -> None:
    with path.open("a", encoding="utf-8") as f:
        for r in records:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")


def _load_jsonl(path: Path) -> pd.DataFrame:
    if not path.exists():
        return pd.DataFrame()
    rows = [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
    return pd.DataFrame(rows) if rows else pd.DataFrame()


def _rtokens(text: str, tokenizer: AutoTokenizer) -> int:
    return len(tokenizer.encode(text or "", add_special_tokens=False))


def _entropy(vals: list[str]) -> float:
    if not vals:
        return float("nan")
    total = len(vals)
    return float(-sum((c / total) * math.log2(c / total)
                      for c in Counter(vals).values()))


# ── Core evaluation loop ──────────────────────────────────────────────────────

def run_eval(args: argparse.Namespace) -> None:
    model_slug = args.model.split("/")[-1]
    # Layout: run_dir/{raw, config, labels, robustness} -- see status_report for why.
    # raw/ = what the model produced, unprocessed. config/ = run settings. labels/ =
    # derived per-checkpoint tables. overall_summary.json stays at the top: it's the
    # one file to check first. robustness/ is written separately by robustness.py.
    run_dir = Path(args.output_dir) / args.dataset / model_slug
    raw_dir, config_dir, labels_dir = run_dir / "raw", run_dir / "config", run_dir / "labels"
    for d in (raw_dir, config_dir, labels_dir):
        d.mkdir(parents=True, exist_ok=True)
    jsonl_path = raw_dir / "sample_records.jsonl"

    print(f"\n{'='*60}")
    print(f"  dataset : {args.dataset}")
    print(f"  model   : {model_slug}")
    print(f"  run dir : {run_dir}")
    print(f"{'='*60}\n")

    cfg = DATASETS[args.dataset]
    is_mc = cfg["is_mc"]

    print("Loading dataset …")
    examples = load_examples(args.dataset, args.num_examples, args.seed)
    examples.to_csv(raw_dir / "examples.csv", index=False)
    print(f"  {len(examples)} examples loaded.")

    print("Loading model …")
    tokenizer = AutoTokenizer.from_pretrained(args.model, trust_remote_code=False)
    llm = LLM(
        model=args.model,
        tensor_parallel_size=args.tensor_parallel_size,
        gpu_memory_utilization=args.gpu_memory_utilization,
        max_model_len=args.max_model_len,
        trust_remote_code=False,
    )
    sampling_params = SamplingParams(
        temperature=args.temperature,
        top_p=args.top_p,
        max_tokens=args.max_tokens,
    )

    # Resume logic
    existing = _load_jsonl(jsonl_path)
    completed: dict[int, int] = {}
    if not existing.empty and args.resume:
        completed = existing.groupby("example_id")["sample_id"].count().astype(int).to_dict()
        print(f"  Resuming: {len(existing)} records already saved.")
    elif jsonl_path.exists() and not args.resume:
        raise FileExistsError(
            f"{jsonl_path} already exists. Pass --resume or delete the run dir."
        )

    # Save config
    (config_dir / "run_config.json").write_text(
        json.dumps(vars(args), indent=2, default=str), encoding="utf-8"
    )

    # Sampling loop
    for _, row in tqdm(examples.iterrows(), total=len(examples), desc="examples"):
        eid = int(row["example_id"])
        already_done = int(completed.get(eid, 0))
        remaining = args.samples_per_example - already_done
        if remaining <= 0:
            continue

        choices = json.loads(row["choices"]) if row["choices"] else None
        prompt = (render_mc_prompt(row["question"], choices, tokenizer) if is_mc
                  else render_freeform_prompt(row["question"], tokenizer))
        _, gold_norm, _ = grade(cfg, None, row["gold_answer"])

        next_sid = already_done
        while remaining > 0:
            batch = min(args.sample_batch_size, remaining)
            outputs = llm.generate([prompt] * batch, sampling_params)

            records = []
            for out in outputs:
                raw = out.outputs[0].text
                parsed = parse_output(raw)
                pred_norm, _, is_correct = grade(cfg, parsed["final_answer"], row["gold_answer"])
                records.append(dict(
                    dataset=args.dataset,
                    model=args.model,
                    example_id=eid,
                    dataset_index=int(row["dataset_index"]),
                    sample_id=next_sid,
                    question=row["question"],
                    gold_answer=row["gold_answer"],
                    gold_answer_norm=gold_norm,
                    raw_completion=raw,
                    reasoning=parsed["reasoning"],
                    final_answer=parsed["final_answer"],
                    final_answer_norm=pred_norm,
                    is_correct=is_correct,
                    parse_success=parsed["parse_success"],
                    parse_error=parsed["parse_error"],
                    reasoning_tokens=_rtokens(parsed["reasoning"], tokenizer),
                    completion_chars=len(raw),
                ))
                next_sid += 1

            _append_jsonl(jsonl_path, records)
            remaining -= batch

    # Metrics
    all_df = _load_jsonl(jsonl_path)

    ex_metrics = build_example_metrics(all_df)
    ex_metrics.to_csv(labels_dir / "example_metrics.csv", index=False)

    summary = dict(
        dataset=args.dataset,
        model=args.model,
        model_slug=model_slug,
        num_examples=int(ex_metrics["example_id"].nunique()),
        samples_per_example=args.samples_per_example,
        total_samples=len(all_df),
        pass_at_1=float(all_df["is_correct"].mean()),
        mean_fraction_correct=float(ex_metrics["fraction_correct"].mean()),
        majority_vote_accuracy=float(ex_metrics["mode_correct"].mean()),
        mean_answer_entropy_bits=float(ex_metrics["answer_entropy_bits"].mean()),
        mean_reasoning_tokens=float(ex_metrics["mean_reasoning_tokens"].mean()),
        parse_success_rate=float(all_df["parse_success"].mean()),
    )
    (run_dir / "overall_summary.json").write_text(
        json.dumps(summary, indent=2), encoding="utf-8"
    )

    print(f"\n{'─'*60}")
    print(f"  pass@1 accuracy  : {summary['pass_at_1']:.1%}")
    print(f"  majority vote    : {summary['majority_vote_accuracy']:.1%}")
    print(f"  mean entropy     : {summary['mean_answer_entropy_bits']:.3f} bits")
    print(f"  mean reasoning   : {summary['mean_reasoning_tokens']:.0f} tokens")
    print(f"  parse success    : {summary['parse_success_rate']:.1%}")
    print(f"  saved to         : {run_dir}")
    print(f"{'─'*60}\n")


# ── CLI ───────────────────────────────────────────────────────────────────────

def summarise_example(grp: "pd.DataFrame") -> "pd.Series":
    """Per-example roll-up over that example's samples (mode, entropy, lengths)."""
    valid = [a for a in grp["final_answer_norm"].dropna() if str(a).strip()]
    mode_cnt = Counter(valid)
    mode_ans = mode_cnt.most_common(1)[0][0] if mode_cnt else None
    gold_n = grp["gold_answer_norm"].iloc[0]
    return pd.Series(dict(
        dataset_index=int(grp["dataset_index"].iloc[0]),
        question=grp["question"].iloc[0],
        gold_answer=grp["gold_answer"].iloc[0],
        num_samples=len(grp),
        fraction_correct=float(grp["is_correct"].mean()),
        parse_success_rate=float(grp["parse_success"].mean()),
        answer_entropy_bits=_entropy(valid),
        mean_reasoning_tokens=float(grp["reasoning_tokens"].mean()),
        median_reasoning_tokens=float(grp["reasoning_tokens"].median()),
        std_reasoning_tokens=float(grp["reasoning_tokens"].std(ddof=0)),
        unique_answers=len(set(valid)),
        mode_answer=mode_ans,
        mode_correct=bool(mode_ans is not None and mode_ans == gold_n),
    ))


def build_example_metrics(all_df: "pd.DataFrame") -> "pd.DataFrame":
    """example_metrics table from raw sample records.

    Module-level so ``reparse.py`` can rebuild these after a parser change without
    duplicating the metric definitions.
    """
    return all_df.groupby("example_id", sort=True).apply(summarise_example).reset_index()


def main() -> None:
    p = argparse.ArgumentParser()
    p.add_argument("--model",    required=True, help="HuggingFace model ID")
    p.add_argument("--dataset",  required=True, choices=list(DATASETS))
    p.add_argument("--output-dir",          default=str(Path(__file__).resolve().parents[1] / "runs" / "sweep"))
    p.add_argument("--num-examples",        type=int,   default=100)
    p.add_argument("--samples-per-example", type=int,   default=10)
    p.add_argument("--sample-batch-size",   type=int,   default=100)
    p.add_argument("--seed",                type=int,   default=42)
    p.add_argument("--temperature",         type=float, default=0.7)
    p.add_argument("--top-p",               type=float, default=0.95)
    p.add_argument("--max-tokens",          type=int,   default=4096)
    p.add_argument("--max-model-len",       type=int,   default=16384,
                   help="cap the KV-cache context; the model advertises 131072, "
                        "which forces a huge cache. Our prompts are short + "
                        "max-tokens<=8192, so 16384 is ample and lets the engine "
                        "run at low gpu-memory-utilization with high concurrency.")
    p.add_argument("--tensor-parallel-size",type=int,   default=1)
    p.add_argument("--gpu-memory-utilization", type=float, default=0.9)
    p.add_argument("--resume",    action="store_true",  default=True)
    p.add_argument("--no-resume", dest="resume", action="store_false")
    args = p.parse_args()
    run_eval(args)


if __name__ == "__main__":
    main()
