# ── Prompts ───────────────────────────────────────────────────────────────────

FREEFORM_SYSTEM = """\
You are solving a math word problem.

Think through the problem carefully. Your response must end with a JSON object \
on the final line that uses exactly this schema:
{"Final Answer": "Answer"}

Rules:
- Put all reasoning before the JSON object.
- Do not use markdown code fences.
- Do not add any text after the JSON object.
- Keep the final answer short (just the number or short phrase).\
"""

MC_SYSTEM = """\
You are solving a multiple-choice question.

Think through the problem carefully. Your response must end with a JSON object \
on the final line that uses exactly this schema:
{"Final Answer": "X"}

where X is the single letter of the correct answer choice (e.g. A, B, C, D).

Rules:
- Put all reasoning before the JSON object.
- Do not use markdown code fences.
- Do not add any text after the JSON object.\
"""


def _apply_chat(system: str, user: str, tokenizer: AutoTokenizer) -> str | None:
    if not getattr(tokenizer, "chat_template", None):
        return None
    try:
        return tokenizer.apply_chat_template(
            [{"role": "system", "content": system}, {"role": "user", "content": user}],
            tokenize=False,
            add_generation_prompt=True,
        )
    except Exception:
        return None


def render_freeform_prompt(question: str, tokenizer: AutoTokenizer) -> str:
    user = f"Solve this problem:\n\n{question.strip()}"
    return _apply_chat(FREEFORM_SYSTEM, user, tokenizer) or (
        f"System:\n{FREEFORM_SYSTEM}\n\nUser:\n{user}\n\nAssistant:\n"
    )


def render_mc_prompt(question: str, choices: list[str], tokenizer: AutoTokenizer) -> str:
    user = f"Question:\n{question.strip()}\n\nChoices:\n" + "\n".join(choices)
    return _apply_chat(MC_SYSTEM, user, tokenizer) or (
        f"System:\n{MC_SYSTEM}\n\nUser:\n{user}\n\nAssistant:\n"
    )


# ── Parsing & normalisation ───────────────────────────────────────────────────

_FINAL_ANSWER_RE = re.compile(
    r'\{\s*"Final Answer"\s*:\s*(?P<value>"(?:\\.|[^"\\])*"|[^{}]+?)\s*\}',
    flags=re.DOTALL,
)
# A bare "ANSWER: B" line -- the convention GPQA-Diamond's own eval harness uses,
# which the model reproduces instead of the JSON schema it was asked for. Anchored to
# a line start so running prose ("...my answer: b is wrong") cannot trigger it, and
# limited to A-E so it covers 4-option (GPQA/OBQA/MMLU) and 5-option (AquaRAT) sets
# without ever matching a numeric free-form answer.
_ANSWER_LINE_RE = re.compile(r"^\s*\**\s*answer\s*\**\s*:\s*\**\s*([A-E])\b",
                             flags=re.IGNORECASE | re.MULTILINE)
_NUMERIC_RE = re.compile(r"-?\d+(?:\.\d+)?")
_LETTER_RE  = re.compile(r"\b([A-Ja-j])\b")
_BOXED_START_RE = re.compile(r"\\boxed\{")


def _clean_reasoning(text: str) -> str:
    text = re.sub(r"^<think>\s*", "", (text or "").strip())
    return re.sub(r"\s*</think>\s*$", "", text).strip()


def _last_boxed(text: str) -> tuple[int, str] | None:
    """(start_offset, content) of the last brace-balanced ``\\boxed{...}`` in text.

    Brace-balanced because LaTeX answers nest braces (``\\boxed{\\frac{1}{2}}``), so
    a non-greedy regex would stop at the first inner ``}``. Returns the start offset
    too so the caller can treat everything before it as the reasoning span.
    """
    found = None
    for m in _BOXED_START_RE.finditer(text):
        depth, i = 1, m.end()
        while i < len(text) and depth > 0:
            depth += 1 if text[i] == "{" else -1 if text[i] == "}" else 0
            i += 1
        if depth == 0:
            found = (m.start(), text[m.end():i - 1])
    return found


def _latex_literal(quoted_value: str) -> str:
    """Recover the literal text of a JSON string value that contains LaTeX.

    LaTeX inside a JSON string is not valid JSON, in two different ways:
      loud   -- ``\\sqrt``/``\\left``/``\\pi`` raise "Invalid \\escape";
      silent -- ``\\frac``/``\\beta``/``\\theta`` ARE valid JSON escapes and decode
                to control characters (``\\frac{1}{2}`` -> formfeed + "rac{1}{2}"),
                so json.loads "succeeds" while corrupting the answer.
    Both are wrong for a math answer, so take the regex-captured text verbatim and
    undo only the one escape the model plausibly meant as an escape: ``\\"``.
    """
    return quoted_value.strip().strip('"').replace('\\"', '"')


def parse_output(raw: str) -> dict[str, Any]:
    raw = raw or ""
    matches = list(_FINAL_ANSWER_RE.finditer(raw))
    if matches:
        m = matches[-1]
        reasoning = _clean_reasoning(raw[: m.start()])
        try:
            parsed = json.loads(m.group(0))
            # Keep the unstripped value for the control-char test below: .strip()
            # would remove a leading formfeed/tab, hiding the very damage we check for
            # ("\frac{1}{2}" -> "\x0crac{1}{2}" -> strips to a clean-looking "rac{1}{2}").
            decoded_raw = str(parsed.get("Final Answer", ""))
            decoded = decoded_raw.strip()
            # json.loads succeeded, but it may have silently eaten LaTeX: \f, \b, \n,
            # \t, \r are legal JSON escapes, so "\frac{1}{2}" decodes to formfeed +
            # "rac{1}{2}". A control character in a final answer always means that
            # happened -- a genuine answer never contains one. Properly escaped input
            # ("\\(" -> "\(") decodes clean and is kept, so this only rescues damage.
            if any(ord(c) < 0x20 for c in decoded_raw):
                return dict(reasoning=reasoning,
                            final_answer=_latex_literal(m.group("value")) or None,
                            parse_success=True, parse_error="latex_literal_recovered",
                            raw_completion=raw)
            return dict(reasoning=reasoning, final_answer=decoded or None,
                        parse_success=True, parse_error=None, raw_completion=raw)
        except json.JSONDecodeError as e:
            # Unescaped LaTeX (\sqrt, \left, \pi) is not valid JSON at all. The regex
            # already captured the exact text, so recover it verbatim instead of
            # discarding a sample whose answer is perfectly readable.
            val = _latex_literal(m.group("value"))
            if val:
                return dict(reasoning=reasoning, final_answer=val,
                            parse_success=True, parse_error="latex_literal_recovered",
                            raw_completion=raw)
            return dict(reasoning=reasoning, final_answer=None,
                        parse_success=False, parse_error=str(e), raw_completion=raw)
    # Fallback: models trained on math-competition data (MATH-500, AIME-style)
    # often ignore the requested JSON schema and emit the \boxed{...} convention
    # they were trained on instead. That still names an unambiguous final answer,
    # so recover it rather than discarding it as an unparseable sample -- but mark
    # it distinctly (parse_error stays diagnostic) so the parser-failure catalog can
    # still see how often this happens.
    boxed = _last_boxed(raw)
    if boxed is not None:
        start, content = boxed
        reasoning = _clean_reasoning(raw[:start])
        return dict(reasoning=reasoning, final_answer=content.strip() or None,
                    parse_success=True, parse_error="used_boxed_fallback", raw_completion=raw)
    # Last resort: a bare "ANSWER: X" line. Reached only when neither the JSON schema
    # nor \boxed{} is present, so it can never override a better-formed answer -- it
    # strictly converts would-be failures into answers. The letter is unambiguous, and
    # without this ~36% of GPQA's continuations were discarded over punctuation alone.
    # Marked distinctly so the parser-failure catalog still counts how often it fires.
    ans = list(_ANSWER_LINE_RE.finditer(raw))
    if ans:
        m = ans[-1]
        return dict(reasoning=_clean_reasoning(raw[: m.start()]),
                    final_answer=m.group(1).upper(),
                    parse_success=True, parse_error="used_answer_line_fallback",
                    raw_completion=raw)
    return dict(reasoning=_clean_reasoning(raw), final_answer=None,
                parse_success=False, parse_error="No JSON found", raw_completion=raw)


def normalize_freeform(text: Any) -> str | None:
    if text is None:
        return None
    v = re.sub(r"\s+", " ",
               str(text).strip().replace("$", "").replace(",", "").rstrip(".").strip("`"))
    nums = _NUMERIC_RE.findall(v)
    if nums:
        n = nums[-1]
        return n[:-2] if n.endswith(".0") else n
    return v.lower() or None


def normalize_mc(text: Any) -> str | None:
    if text is None:
        return None
    v = str(text).strip()
    m = _LETTER_RE.search(v)
    if m:
        return m.group(1).upper()
    return v[0].upper() if v and v[0].isalpha() else None


def _normalize_math(text: Any) -> str | None:
    """Best-effort canonical string for a symbolic answer, for entropy/mode grouping.

    Not the correctness check (see ``_is_correct_math``) -- two differently-written
    but equal expressions can still land on different canonical strings here. That
    would show up as slightly inflated answer_entropy_bits, not as a wrong is_correct
    label, so it is a grouping-fidelity caveat rather than a grading bug.
    """
    if text is None:
        return None
    v = str(text).strip()
    if not v:
        return None
    try:
        parsed = math_verify.parse(f"\\boxed{{{v}}}")
        return str(parsed[0]) if parsed else v.lower()
    except Exception:
        return v.lower()


def _is_correct_math(pred_text: Any, gold_text: Any) -> bool:
    """Symbolic equivalence via math-verify (handles 1/2 == 0.5 == \\frac{1}{2}, etc.)."""
    if pred_text is None or gold_text is None:
        return False
    try:
        pred_p = math_verify.parse(f"\\boxed{{{pred_text}}}")
        gold_p = math_verify.parse(f"\\boxed{{{gold_text}}}")
        if not pred_p or not gold_p:
            return False
        return bool(math_verify.verify(gold_p, pred_p))
    except Exception:
        return False


def grade(cfg: dict, pred_text: Any, gold_text: Any) -> tuple[str | None, str | None, bool]:
    """(pred_norm, gold_norm, is_correct) for a dataset's grading scheme.

    Default ("exact", every dataset through mmlu_pro_math/arc_challenge/openbookqa):
    normalize_mc/normalize_freeform then string equality -- unchanged from before this
    function existed. "math_verify" (MATH-500) uses symbolic equivalence for
    is_correct instead, since answers are LaTeX expressions, not bare numbers.
    """
    if cfg.get("grading") == "math_verify":
        return (_normalize_math(pred_text), _normalize_math(gold_text),
                _is_correct_math(pred_text, gold_text))
    normalize = normalize_mc if cfg["is_mc"] else normalize_freeform
    pred_norm = normalize(pred_text)
    gold_norm = normalize(gold_text)
    return pred_norm, gold_norm, bool(pred_norm is not None and pred_norm == gold_norm)


# ── Dataset registry ──────────────────────────────────────────────────────────

_GSM8K_ANS_RE = re.compile(r"####\s*(.+)")


def _gsm8k_gold(ex: dict) -> str:
    m = _GSM8K_ANS_RE.search(ex["answer"])
    return m.group(1).strip() if m else ""


def _arc_gold(ex: dict) -> str:
    k = ex["answerKey"].strip()
    return chr(ord("A") + int(k) - 1).upper() if k.isdigit() else k.upper()


def _arc_choices(ex: dict) -> list[str]:
    return [f"{l}) {t}" for l, t in zip(ex["choices"]["label"], ex["choices"]["text"])]


def _mathqa_choices(ex: dict) -> list[str]:
    return [o.strip() for o in re.split(r",\s*(?=[a-e]\s*\))", ex["options"])]


def _mmlu_choices(ex: dict) -> list[str]:
    return [f"{chr(65 + i)}) {t}" for i, t in enumerate(ex["options"])]


def _gpqa_shuffled(ex: dict) -> list[str]:
    """The 4 GPQA options in a per-question-deterministic shuffled order.

    The raw fields always list the correct answer first (``Correct Answer``, then
    ``Incorrect Answer 1/2/3``), so an unshuffled MC prompt would leak the answer via
    position. ``choices()`` and ``gold()`` are called independently by
    ``load_examples`` with no shared state, so the shuffle is seeded from the
    question's own Record ID -- both calls reproduce the identical order.
    """
    # Several rows carry trailing newlines in the answer text ("10^-8 eV\n"), which
    # would render as ragged choice lines in the prompt; strip before shuffling so
    # the gold lookup below compares against the same cleaned text.
    opts = [str(ex["Correct Answer"]).strip(), str(ex["Incorrect Answer 1"]).strip(),
            str(ex["Incorrect Answer 2"]).strip(), str(ex["Incorrect Answer 3"]).strip()]
    order = list(range(4))
    random.Random(ex["Record ID"]).shuffle(order)
    return [opts[i] for i in order]


def _gpqa_choices(ex: dict) -> list[str]:
    shuffled = _gpqa_shuffled(ex)
    return [f"{chr(65 + i)}) {t}" for i, t in enumerate(shuffled)]


def _gpqa_gold(ex: dict) -> str:
    shuffled = _gpqa_shuffled(ex)
    # .strip() to match _gpqa_shuffled's cleaning -- the raw field can carry a
    # trailing newline, which would make this lookup miss and raise ValueError.
    return chr(65 + shuffled.index(str(ex["Correct Answer"]).strip()))


