# ─────────────────────────────────────────────────────────────────────────────
# What this repo tracks: code, configuration, and the handoff context in
# .claude/.  It deliberately does NOT track generated artifacts -- run outputs,
# model weights, virtualenvs, or the downloaded datasets.  Everything ignored
# here is reproducible on the target cluster; see .claude/SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Run outputs (~30 GB: .npy activations, .jsonl raw records, figures) ───────
# Regenerated by the pipeline. The launcher scripts are kept (negated below)
# because they are the recipe, not the output.
runs/**
!runs/**/
!runs/**/*.sh

# The vendored EasySteer checkout (1.5 GB, its own git repo + submodule).
# Rebuilt from scratch by runs/goal2/setup_easysteer.sh -- never commit it.
runs/goal2/_src/**

# ── Datasets (~89 MB) ────────────────────────────────────────────────────────
# Re-fetched with:  python src/setup/download_dataset.py
data/**
!data/.gitkeep

# ── Virtualenvs / caches / model weights ─────────────────────────────────────
.venv-easysteer/
.venv/
venv/
.hf_home/
.outlines_cache*/
*.safetensors
*.gguf
*.pt
*.bin

# ── Prior-project reference results (28 MB of PNG/CSV from the Qwen3 work) ───
# archive/src and archive/notebooks ARE tracked; only the bulky outputs are not.
archive/results/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# ── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
*.swp
*~

# ── Local-only Claude settings (shared context in .claude/ IS tracked) ────────
.claude/settings.local.json
